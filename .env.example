# Copy this file to .env and change every password before running.
# .env is git-ignored; never commit real secrets.

# --- Neo4j ---------------------------------------------------------------
# Password must be at least 8 characters (Neo4j 5 requirement).
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
# How the backend reaches Neo4j. Inside Docker Compose this is the service name.
NEO4J_URI=bolt://neo4j:7687

# --- PostgreSQL (relational baseline, used only for the benchmark) -------
POSTGRES_USER=fraudmesh
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fraudmesh

# --- Backend --------------------------------------------------------------
# Comma-separated list of origins allowed to call the API (the dashboard).
CORS_ORIGINS=http://localhost:5173
# Secret key (16+ characters) for hashing card/phone numbers and addresses.
# Must stay the same once data is loaded, or new hashes won't match old ones.
PII_HASH_KEY=change-me-to-a-long-random-string
# Secret (32+ characters) that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Password given to the seeded users admin / analyst / viewer (make seed).
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
# PostgreSQL host as seen by the backend (the Compose service name).
POSTGRES_HOST=postgres
LOG_LEVEL=INFO

# --- Frontend -------------------------------------------------------------
# URL the browser uses to reach the backend.
VITE_API_URL=http://localhost:8000
